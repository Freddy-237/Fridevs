---
/**
 * FOOTER SIMPLIFIÉ
 * 
 * Footer épuré et professionnel
 * Design: Fond sombre premium avec navigation claire
 * Style: Minimaliste et corporate
 */
---

<!-- FOOTER -->
<footer class="bg-[#0A0D13] text-gray-400">
  
  <!-- Section principale -->
  <div class="border-b border-gray-800">
    <div class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid md:grid-cols-2 gap-8 md:gap-12">
        
        <!-- Zone 1 - Marque -->
        <div class="space-y-6">
          <!-- Logo -->
          <div>
            <img src="/images/f.png" alt="FRIDEVS" class="h-10 w-auto" loading="lazy" width="100" height="40" />
          </div>          
          <!-- Réseaux sociaux -->
          <div class="flex items-center gap-4">
            <a href="https://www.facebook.com/profile.php?id=61577729167828" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-purple-400 transition-colors duration-200" aria-label="Facebook">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/fridev2/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-purple-400 transition-colors duration-200" aria-label="Instagram">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>        </div>

        <!-- Zone 2 - Contact & Info -->
        <div class="space-y-4 text-sm">
          <!-- Email -->
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contact@fridevs.com" class="hover:text-purple-400 transition-colors duration-200">
              contact@fridevs.com
            </a>
          </div>

          <!-- Localisation -->
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-purple-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Travail à distance – Clients internationaux</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Barre inférieure -->
  <div class="bg-[#07090F]">
    <div class="max-w-7xl mx-auto px-6 py-6">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-sm text-gray-500">
        
        <!-- Copyright -->
        <div class="text-center md:text-left">
          © FRIDEVS {new Date().getFullYear()}. Tous droits réservés.
        </div>

        <!-- Liens légaux -->
        <div class="flex flex-wrap justify-center md:justify-end gap-x-6 gap-y-2">
          <a href="/mentions-legales" class="hover:text-purple-400 transition-colors duration-200">
            Mentions légales
          </a>
          <a href="/politique-confidentialite" class="hover:text-purple-400 transition-colors duration-200">
            Politique de confidentialité
          </a>
          <a href="#" data-cookie-settings class="hover:text-purple-400 transition-colors duration-200">
            Gérer les cookies
          </a>
        </div>
      </div>
    </div>
  </div>

</footer>
