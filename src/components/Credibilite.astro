---
/**
 * SECTION CRÉDIBILITÉ
 * 
 * Affiche les technologies, années d'expérience et chiffres clés
 * Design: Fond #111827 avec logos et stats
 * Animation: Logos gris → blanc au hover
 */
---

<!-- SECTION CRÉDIBILITÉ -->
<section class="py-20 bg-[#111827]">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Titre -->
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'DM Sans Variable', sans-serif;">
        Une expertise reconnue
      </h2>
      <p class="text-gray-400 text-lg">
        Technologies modernes et résultats prouvés
      </p>
    </div>

    <!-- Chiffres clés -->
    <div class="grid md:grid-cols-3 gap-8 mb-16">
      
      <!-- Stat 1: Années d'expérience -->
      <div class="text-center p-8 bg-[#0B0E14] rounded-2xl border border-gray-800">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600 mb-2">
          1+
        </div>
        <p class="text-gray-400 text-lg">Années d'expérience</p>
      </div>

      <!-- Stat 2: Projets livrés -->
      <div class="text-center p-8 bg-[#0B0E14] rounded-2xl border border-gray-800">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600 mb-2">
          15+
        </div>
        <p class="text-gray-400 text-lg">Projets livrés</p>
      </div>

      <!-- Stat 3: Clients satisfaits -->
      <div class="text-center p-8 bg-[#0B0E14] rounded-2xl border border-gray-800">
        <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600 mb-2">
          100%
        </div>
        <p class="text-gray-400 text-lg">Clients satisfaits</p>
      </div>

    </div>

    <!-- Technologies utilisées -->
    <div>
      <h3 class="text-2xl font-bold text-white text-center mb-8" style="font-family: 'Space Grotesk Variable', sans-serif;">
        Technologies que nous maîtrisons
      </h3>

      <!-- Grille de logos technos -->
      <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 lg:gap-8">
        
        <!-- React -->
