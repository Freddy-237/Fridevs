---
/**
 * SECTION SOLUTIONS FRIDEVS
 * 
 * Présente les 4 expertises principales de FRIDEVS
 * Design: Fond sombre #111827 avec cards horizontales
 * Animation: Déplacement léger + soulignement animé au hover
 */
---

<!-- SECTION SOLUTIONS FRIDEVS -->
<section class="py-20 bg-[#111827]">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Titre aligné gauche -->
    <div class="mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4" style="font-family: 'DM Sans Variable', sans-serif;">
        Nos 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
          expertises
        </span>
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl">
        Des services digitaux conçus pour accompagner votre croissance, de la stratégie à la mise en production.
      </p>
    </div>

    <!-- Grille de 4 cards horizontales -->
    <div class="grid gap-6">
      
      <!-- Card 1: Développement Web & Mobile -->
      <div class="solution-card group bg-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 hover:translate-x-2">
        
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <!-- Icône minimaliste -->
          <div class="flex-shrink-0 w-16 h-16 bg-purple-600/10 rounded-xl flex items-center justify-center group-hover:bg-purple-600/20 transition-colors">
            <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>

          <!-- Contenu -->
          <div class="flex-1">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk Variable', sans-serif;">
              Développement Web & Mobile
            </h3>
            <p class="text-gray-400 leading-relaxed mb-4">
              Création de plateformes web et applications modernes, rapides et sécurisées. Sites vitrines, applications web progressives, applications mobiles natives et APIs robustes.
            </p>
            <p class="text-sm text-gray-300 mb-4">
              Sites web dès <strong class="text-purple-400">50 000 FCFA</strong> · Applications dès <strong class="text-purple-400">300 000 FCFA</strong>
            </p>
            
            <!-- Lien violet avec soulignement animé -->
            <a href="/services#developpement" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium group/link">
              <span class="relative">
                En savoir plus
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-400 group-hover/link:w-full transition-all duration-300"></span>
              </span>
              <svg class="ml-2 w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

        </div>
      </div>

      <!-- Card 2: Solutions métiers sur mesure -->
      <div class="solution-card group bg-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 hover:translate-x-2">
        
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <div class="flex-shrink-0 w-16 h-16 bg-purple-600/10 rounded-xl flex items-center justify-center group-hover:bg-purple-600/20 transition-colors">
            <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk Variable', sans-serif;">
              Solutions métiers sur mesure
            </h3>
            <p class="text-gray-400 leading-relaxed mb-4">
              Conception d'outils internes adaptés à vos processus et à votre croissance. CRM personnalisés, outils de gestion internes et automatisation de processus métier.
            </p>
            
            <a href="/services#solutions-metiers" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium group/link">
              <span class="relative">
                Découvrir nos solutions
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-400 group-hover/link:w-full transition-all duration-300"></span>
              </span>
              <svg class="ml-2 w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

        </div>
      </div>

      <!-- Card 3: SEO & visibilité digitale -->
      <div class="solution-card group bg-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 hover:translate-x-2">
        
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <div class="flex-shrink-0 w-16 h-16 bg-purple-600/10 rounded-xl flex items-center justify-center group-hover:bg-purple-600/20 transition-colors">
            <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk Variable', sans-serif;">
              SEO & croissance digitale
            </h3>
            <p class="text-gray-400 leading-relaxed mb-4">
              Optimisation technique et stratégique pour attirer des prospects qualifiés. SEO technique, stratégie de contenu et optimisation des performances pour un trafic qualifié.
            </p>
            
            <a href="/services#seo" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium group/link">
              <span class="relative">
                Booster votre visibilité
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-400 group-hover/link:w-full transition-all duration-300"></span>
              </span>
              <svg class="ml-2 w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

        </div>
      </div>

      <!-- Card 4: UI/UX & Branding -->
      <div class="solution-card group bg-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 hover:translate-x-2">
        
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <div class="flex-shrink-0 w-16 h-16 bg-purple-600/10 rounded-xl flex items-center justify-center group-hover:bg-purple-600/20 transition-colors">
            <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk Variable', sans-serif;">
              Design UI/UX & Branding
            </h3>
            <p class="text-gray-400 leading-relaxed mb-4">
              Des interfaces élégantes et intuitives qui renforcent votre image de marque. Design d'interfaces, identité visuelle complète et création de logos et chartes graphiques.
            </p>
            
            <a href="/services#design" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium group/link">
              <span class="relative">
                Créer votre identité
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-400 group-hover/link:w-full transition-all duration-300"></span>
              </span>
              <svg class="ml-2 w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

        </div>
      </div>


      <!-- Card 5: Déploiement & Cloud -->
      <div class="solution-card group bg-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 hover:translate-x-2">
        
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <div class="flex-shrink-0 w-16 h-16 bg-purple-600/10 rounded-xl flex items-center justify-center group-hover:bg-purple-600/20 transition-colors">
            <svg class="w-8 h-8 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 17v-5m0 0l-2 2m2-2l2 2" />
            </svg>
          </div>

          <div class="flex-1">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk Variable', sans-serif;">
              Déploiement & Cloud
            </h3>
            <p class="text-gray-400 leading-relaxed mb-4">
              Mise en ligne de vos sites et applications sur le cloud : hébergement, nom de domaine, HTTPS, déploiement automatisé, sauvegardes et maintenance. Votre service reste rapide et disponible.
            </p>
            
            <a href="/services#cloud" class="inline-flex items-center text-purple-400 hover:text-purple-300 font-medium group/link">
              <span class="relative">
                Mettre en ligne votre projet
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-purple-400 group-hover/link:w-full transition-all duration-300"></span>
              </span>
              <svg class="ml-2 w-5 h-5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </div>

        </div>
      </div>
    </div>

    <!-- CTA: Découvrir tous nos services -->
    <div class="text-center mt-12">
      <a 
        href="/services" 
        class="inline-flex items-center px-8 py-4 bg-purple-600/10 hover:bg-purple-600 text-purple-400 hover:text-white border border-purple-500/50 hover:border-purple-600 font-semibold rounded-lg transition-all duration-300"
        style="font-family: 'Space Grotesk Variable', sans-serif;"
      >
        Découvrir tous nos services
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>

</section>
