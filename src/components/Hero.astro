---
/**
 * HERO SECTION - Section d'accueil principale
 * 
 * Design: Dégradé sombre noir → violet foncé
 * Layout: 2 colonnes (texte + visuel animé)
 * Animation: Fade + slide pour le texte, animation tech pour le visuel
 */
---

<!-- HERO SECTION -->
<section class="relative min-h-[75vh] flex items-center overflow-hidden bg-gradient-to-br from-[#0B0E14] via-[#1a062e] to-[#2A234A] pt-28 pb-12 md:pt-32 md:pb-16">
  
  <!-- Animation de fond: lignes violettes subtiles -->
  <div class="absolute inset-0 opacity-10">
    <div class="hero-grid"></div>
  </div>

  <!-- Conteneur principal -->
  <div class="relative max-w-7xl mx-auto px-6 w-full grid md:grid-cols-2 gap-12 items-center">
    
    <!-- COLONNE GAUCHE: Texte principal -->
    <div class="text-white space-y-5 hero-text-fade">
      
      <!-- Titre H1 - DM Sans, blanc, très large -->
      <h1 class="hero-title-animated text-3xl md:text-4xl lg:text-5xl font-bold leading-tight" style="font-family: 'DM Sans Variable', 'Space Grotesk Variable', sans-serif;">
        FRIDEVS conçoit des 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
          solutions digitales
        </span> 
        qui accélèrent la croissance des entreprises.
      </h1>

      <!-- Sous-titre - Gris premium -->
      <p class="text-lg md:text-xl text-gray-300 leading-relaxed max-w-2xl">
        Nous développons des sites web, applications et outils métiers performants, pensés pour générer de vrais résultats.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 pt-2">
        
        <!-- CTA Principal: Violet plein + glow -->
        <a 
          href="https://wa.me/237694634551" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white text-lg font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-purple-500/50 hover:scale-105"
          style="font-family: 'Space Grotesk Variable', sans-serif;"
        >
          Demander un devis
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <!-- CTA Secondaire: Outline violet -->
        <a 
          href="#realisations" 
          class="inline-flex items-center justify-center px-6 py-3 border-2 border-purple-500 text-purple-300 text-lg hover:text-white hover:bg-purple-500/10 font-semibold rounded-lg transition-all duration-300"
          style="font-family: 'Space Grotesk Variable', sans-serif;"
        >
          Voir nos réalisations
        </a>

      </div>

    </div>

    <!-- COLONNE DROITE: Visuel animé tech -->
    <div class="relative">
      
      <!-- Container pour l'animation -->
      <div class="hero-visual-container relative w-full h-[300px] md:h-[500px]">
        
        <!-- Animation réseau / data flow -->
        <div class="absolute inset-0 flex items-center justify-center">
          
          <!-- Cercles animés -->
          <div class="hero-circle-1 absolute w-64 h-64 border-2 border-purple-500/30 rounded-full"></div>
          <div class="hero-circle-2 absolute w-80 h-80 border-2 border-purple-400/20 rounded-full"></div>
          <div class="hero-circle-3 absolute w-96 h-96 border-2 border-purple-300/10 rounded-full"></div>

          <!-- Points lumineux -->
          <div class="hero-dots absolute inset-0">
            <div class="hero-dot absolute top-1/4 left-1/4 w-3 h-3 bg-purple-400 rounded-full shadow-lg shadow-purple-400/50"></div>
            <div class="hero-dot absolute top-3/4 left-1/3 w-2 h-2 bg-purple-500 rounded-full shadow-lg shadow-purple-500/50"></div>
            <div class="hero-dot absolute top-1/2 right-1/4 w-4 h-4 bg-purple-300 rounded-full shadow-lg shadow-purple-300/50"></div>
            <div class="hero-dot absolute bottom-1/4 right-1/3 w-2 h-2 bg-purple-600 rounded-full shadow-lg shadow-purple-600/50"></div>
          </div>

          <!-- Centre: PC 3D -->
          <div class="relative z-10 laptop-3d" style="transform-style: preserve-3d; perspective: 1000px;">
            <!-- Écran du laptop -->
            <div class="laptop-screen">
              <div class="screen-content">
                <div class="code-line" style="animation-delay: 0s;"></div>
                <div class="code-line" style="animation-delay: 0.2s;"></div>
                <div class="code-line short" style="animation-delay: 0.4s;"></div>
                <div class="code-line" style="animation-delay: 0.6s;"></div>
              </div>
            </div>
            <!-- Base du laptop -->
            <div class="laptop-base"></div>
            <!-- Clavier -->
            <div class="laptop-keyboard"></div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Indicateur de scroll -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" role="img" aria-label="Faites défiler vers le bas">
      <title>Scroll</title>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>

</section>

<!-- Script pour l'animation du Hero -->
<script type="module" src="/js/hero-animation.js" defer></script>
