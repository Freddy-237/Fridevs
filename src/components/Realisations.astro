---
/**
 * SECTION RÉALISATIONS (Aperçu)
 * 
 * Affiche 3 projets en vedette
 * Design: Fond sombre avec grille de cards projets
 * Animation: Overlay violet au hover sur les images
 */
---

<!-- SECTION RÉALISATIONS -->
<section class="py-20 bg-[#0B0E14]">
  
  <div class="max-w-7xl mx-auto px-6">
    
    <!-- Titre -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4" style="font-family: 'DM Sans', sans-serif;">
        Des projets 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
          concrets
        </span>, des résultats mesurables
      </h2>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto">
        Chaque projet FRIDEVS est conçu pour répondre à un besoin réel et produire un impact durable
      </p>
    </div>

    <!-- Grille 3 projets -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Projet 1: INUBIL -->
      <div class="project-card group bg-[#111827] rounded-2xl overflow-hidden border border-gray-800 hover:border-purple-500/50 transition-all duration-300">
        
        <!-- Image avec overlay -->
        <div class="relative h-64 overflow-hidden bg-gradient-to-br from-purple-900/20 to-purple-800/20">
          
          <!-- Placeholder image - Remplacer par vraie image -->
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="w-24 h-24 text-purple-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>

          <!-- Overlay violet au hover -->
          <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/80 group-hover:to-purple-900/80 transition-all duration-500 flex items-center justify-center opacity-0 group-hover:opacity-100">
            <span class="text-white font-bold text-xl">Voir le projet</span>
          </div>
        </div>

        <!-- Contenu -->
        <div class="p-6">
          
          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">CRM</span>
            <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">Solution métier</span>
          </div>

          <!-- Titre -->
          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk', sans-serif;">
            INUBIL
          </h3>

          <!-- Description -->
          <p class="text-gray-400 mb-4">
            Solution CRM complète pour la gestion des relations clients et l'automatisation des processus commerciaux.
          </p>

          <!-- Résultats -->
          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-800">
            <div>
              <p class="text-purple-400 font-bold text-lg">+35%</p>
              <p class="text-gray-500 text-sm">Productivité</p>
            </div>
            <div>
              <p class="text-purple-400 font-bold text-lg">-25%</p>
              <p class="text-gray-500 text-sm">Temps de traitement</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Projet 2: Application Mobile -->
      <div class="project-card group bg-[#111827] rounded-2xl overflow-hidden border border-gray-800 hover:border-purple-500/50 transition-all duration-300">
        
        <div class="relative h-64 overflow-hidden bg-gradient-to-br from-purple-900/20 to-purple-800/20">
          
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="w-24 h-24 text-purple-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>

          <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/80 group-hover:to-purple-900/80 transition-all duration-500 flex items-center justify-center opacity-0 group-hover:opacity-100">
            <span class="text-white font-bold text-xl">Voir le projet</span>
          </div>
        </div>

        <div class="p-6">
          
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">Mobile</span>
            <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">E-commerce</span>
          </div>

          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk', sans-serif;">
            Application E-commerce
          </h3>

          <p class="text-gray-400 mb-4">
            Application mobile native pour une expérience shopping fluide et personnalisée sur iOS et Android.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-800">
            <div>
              <p class="text-purple-400 font-bold text-lg">2.5K+</p>
              <p class="text-gray-500 text-sm">Téléchargements</p>
            </div>
            <div>
              <p class="text-purple-400 font-bold text-lg">4.5/5</p>
              <p class="text-gray-500 text-sm">Note utilisateurs</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Projet 3: Plateforme Web -->
      <div class="project-card group bg-[#111827] rounded-2xl overflow-hidden border border-gray-800 hover:border-purple-500/50 transition-all duration-300">
        
        <div class="relative h-64 overflow-hidden bg-gradient-to-br from-purple-900/20 to-purple-800/20">
          
          <div class="absolute inset-0 flex items-center justify-center">
            <svg class="w-24 h-24 text-purple-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>

          <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/80 group-hover:to-purple-900/80 transition-all duration-500 flex items-center justify-center opacity-0 group-hover:opacity-100">
            <span class="text-white font-bold text-xl">Voir le projet</span>
          </div>
        </div>

        <div class="p-6">
          
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">Mobile</span>
            <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">iOS/Android</span>
          </div>

          <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk', sans-serif;">
            Application mobile de plomberie
          </h3>

          <p class="text-gray-400 mb-4">
            Application mobile complète pour la gestion d'interventions de plomberie avec géolocalisation et système de réservation en temps réel.
          </p>

          <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-800">
            <div>
              <p class="text-purple-400 font-bold text-lg">500+</p>
              <p class="text-gray-500 text-sm">Téléchargements</p>
            </div>
            <div>
              <p class="text-purple-400 font-bold text-lg">4.3/5</p>
              <p class="text-gray-500 text-sm">Note moyenne</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- CTA: Voir toutes les réalisations -->
    <div class="text-center mt-12">
      <a 
        href="/realisations" 
        class="inline-flex items-center px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-purple-500/50"
        style="font-family: 'Space Grotesk', sans-serif;"
      >
        Voir toutes nos réalisations
        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>

</section>
