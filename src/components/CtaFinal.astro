---
/**
 * SECTION CTA FINAL
 * 
 * Appel à l'action final pour demander un devis
 * Design: Fond violet foncé #2A234A avec bouton blanc
 * Animation: Simple hover effect
 */
---

<!-- SECTION CTA FINAL -->
<section class="py-16 bg-[#0B0E14] relative overflow-hidden border-t border-purple-500/20">
  
  <!-- Ligne de gradient en haut -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
      
      <!-- Texte à gauche -->
      <div class="text-left flex-1">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight" style="font-family: 'DM Sans Variable', sans-serif;">
          Transformons vos idées en 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
            réalité digitale
          </span>
        </h2>
        <p class="text-lg text-gray-400 leading-relaxed">
          Discutons de votre projet. Devis gratuit sous 48h, sans engagement.
        </p>
      </div>

      <!-- Boutons à droite -->
      <div class="flex flex-col sm:flex-row gap-4 flex-shrink-0">
        
        <a 
          href="https://wa.me/237694634551" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold text-base rounded-lg transition-all duration-300 shadow-lg shadow-purple-500/30 hover:shadow-purple-500/50 hover:scale-105"
          style="font-family: 'Space Grotesk Variable', sans-serif;"
        >
          Demander un devis
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <a 
          href="https://wa.me/237694634551" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 border-2 border-purple-500 text-purple-300 hover:text-white hover:bg-purple-500/10 font-semibold text-base rounded-lg transition-all duration-300"
          style="font-family: 'Space Grotesk Variable', sans-serif;"
        >
          <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Nous appeler
        </a>

      </div>

    </div>

  </div>

</section>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="text-sm">Accompagnement personnalisé</span>
      </div>

    </div>

  </div>

</section>
