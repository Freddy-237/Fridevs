---
/**
 * HEADER STICKY
 * 
 * Header fixe avec effet de transparence au scroll
 * Design: Transparent → #0B0E14 au scroll avec blur
 * Animation: Smooth transition
 */
---

<!-- FRIDEVS HEADER - Sticky avec glassmorphism -->
<header id="main-header" class="fixed top-0 left-0 right-0 z-50 bg-[#0B0E14]/95 backdrop-blur-sm text-white transition-all duration-300 shadow-md shadow-purple-500/20">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

    <!-- Logo -->
    <a href="#" class="flex items-center gap-2">
      <img src="/images/f.png" alt="FRIDEVS - Agence digitale de développement web et mobile" class="h-10 w-25" />
    </a>

    <!-- Desktop Menu -->
    <nav class="hidden md:flex items-center gap-8 text-lg font-medium tracking-wide" style="font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;">
      <a href="/" class="text-gray-300 hover:text-purple-400 transition-colors duration-200">Accueil</a>
      <a href="/services" class="text-gray-300 hover:text-purple-400 transition-colors duration-200">Services</a>
      <a href="/realisations" class="text-gray-300 hover:text-purple-400 transition-colors duration-200">Réalisations</a>
      <a href="/about" class="text-gray-300 hover:text-purple-400 transition-colors duration-200">À propos</a>
      <a href="/contact" class="text-gray-300 hover:text-purple-400 transition-colors duration-200">Contact</a>
    </nav>

    <!-- CTA Button avec glow effect -->
    <a href="https://wa.me/237694634551" target="_blank" rel="noopener noreferrer" class="hidden md:flex items-center px-5 py-2.5 bg-purple-600 hover:bg-purple-700 transition-all duration-300 rounded-lg font-semibold shadow-lg hover:shadow-purple-500/50 text-sm" style="font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;">
      Demander un devis
      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-white text-3xl">
      ☰
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden flex-col bg-[#0B0E14] px-6 pb-4 space-y-4 text-lg border-t border-gray-800" style="font-family: 'Space Grotesk', 'Inter', system-ui, sans-serif;">
    <a href="/" class="block py-3 hover:text-purple-300 transition-colors">Accueil</a>
    <a href="/services" class="block py-3 hover:text-purple-300 transition-colors">Services</a>
    <a href="/realisations" class="block py-3 hover:text-purple-300 transition-colors">Réalisations</a>
    <a href="/about" class="block py-3 hover:text-purple-300 transition-colors">À propos</a>
    <a href="/contact" class="block py-3 hover:text-purple-300 transition-colors">Contact</a>

    <a href="https://wa.me/237694634551" target="_blank" rel="noopener noreferrer" class="block bg-purple-600 hover:bg-purple-700 transition-all duration-300 px-5 py-2.5 rounded-lg font-semibold text-center shadow-md mt-4">
      Demander un devis
    </a>
  </div>
</header>

<!-- Script pour le header sticky avec effet au scroll -->
<script type="module" src="/js/header-scroll.js" defer></script>
<script type="module" src="/js/index.js" defer></script>
