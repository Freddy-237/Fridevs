---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "FRIDEVS - Solutions Digitales Sur Mesure | Développement Web & Mobile",
  description = "Nous développons des sites web, applications et outils métiers performants pour accélérer la croissance de votre entreprise. Expertise en développement web/mobile, solutions métiers, SEO et UI/UX.",
  image = "/images/og-fridevs.png",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="FRIDEVS" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Preload critical images -->
    <link rel="preload" as="image" href="/images/f.png" fetchpriority="high" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FRIDEVS - Solutions digitales sur mesure" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="FRIDEVS" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/images/icon.png" />
    
    <!-- Consent Mode v2 : mesure d'audience refusée par défaut, jusqu'au choix du visiteur -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var fridevsConsent = null;
      try { fridevsConsent = localStorage.getItem('fridevs-consent'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: fridevsConsent === 'granted' ? 'granted' : 'denied',
        wait_for_update: 500
      });
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-NN5WKSRJ');
    </script>
    <!-- End Google Tag Manager -->
    
    <!-- Polices auto-hébergées (@fontsource-variable), importées dans le frontmatter -->
    
    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "FRIDEVS",
        "url": "https://fridevs.com",
        "logo": "https://fridevs.com/images/f.png",
        "description": "Agence digitale spécialisée en développement web, mobile et solutions métiers sur mesure",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "CM"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+237694634551",
          "contactType": "customer service",
          "availableLanguage": ["fr", "en"]
        },
        "sameAs": [
          "https://wa.me/237694634551",
          "https://www.facebook.com/profile.php?id=61577729167828",
          "https://www.instagram.com/fridev2/"
        ]
      }
    </script>
  </head>
  <body class="text-gray-800 bg-[#0B0E14] overflow-x-hidden" style="font-family: 'Inter Variable', system-ui, sans-serif;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NN5WKSRJ"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <slot />

    <CookieBanner />

    <!-- Suivi des conversions : événements envoyés à GTM (dataLayer) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var event = null;
        if (href.indexOf('wa.me/') !== -1) event = 'whatsapp_click';
        else if (href.indexOf('play.google.com') !== -1) event = 'playstore_click';
        else if (href.indexOf('mailto:') === 0) event = 'email_click';
        else if (href.indexOf('tel:') === 0) event = 'phone_click';
        if (!event) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: event, link_url: href, page_path: location.pathname });
      });
    </script>
  </body>
</html>
