---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "À Propos - FRIDEVS | Partenaire Digital de Confiance";
const pageDescription = "FRIDEVS est une agence digitale spécialisée dans la conception de solutions web et applicatives sur mesure. Découvrez notre mission, nos valeurs et notre vision.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  
  <main>
    <!-- HERO - À PROPOS -->
    <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-gradient-to-b from-[#3B2667] via-[#553C9A] to-[#7C3AED] pt-28 pb-16 md:pt-32 md:pb-20">
      
      <!-- Animation de fond -->
      <div class="absolute inset-0 opacity-10">
        <div style="background-image: linear-gradient(rgba(139, 92, 246, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.1) 1px, transparent 1px); background-size: 50px 50px; width: 100%; height: 100%;"></div>
      </div>

      <div class="relative max-w-6xl mx-auto px-6 text-center">
        
        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-purple-400 transition-colors">Accueil</a>
          <span class="mx-2">/</span>
          <span class="text-purple-400">À Propos</span>
        </nav>

        <!-- Titre -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" style="font-family: 'DM Sans', sans-serif;">
          FRIDEVS, partenaire digital de 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
            confiance
          </span>
        </h1>

        <!-- Sous-titre -->
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto">
          Une agence dédiée à la performance, à la clarté et à la valeur métier
        </p>
      </div>
    </section>

    <!-- SECTION 1 - QUI NOUS SOMMES -->
    <section class="py-24 bg-[#0B0E14]">
      <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-12 items-center max-w-6xl mx-auto">
          <!-- Gauche : Texte -->
          <div class="space-y-6 fade-in-left">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
              Qui nous sommes
            </h2>
            <p class="text-lg text-gray-300 leading-relaxed">
              <span class="text-purple-400 font-semibold">FRIDEVS</span> est une agence digitale spécialisée dans la conception de solutions web et applicatives sur mesure.
            </p>
            <p class="text-lg text-gray-300 leading-relaxed">
              Nous accompagnons les entreprises dans leur transformation digitale avec une approche orientée <span class="text-purple-400">performance</span>, <span class="text-purple-400">simplicité</span> et <span class="text-purple-400">résultats concrets</span>.
            </p>
          </div>

          <!-- Droite : Visuel abstrait -->
          <div class="relative h-96 fade-in-right">
            <div class="absolute inset-0 bg-gradient-to-br from-purple-600/20 to-purple-900/20 rounded-2xl backdrop-blur-sm border border-purple-500/20">
              <div class="absolute inset-0 flex items-center justify-center">
                <svg class="w-64 h-64 text-purple-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2 - NOTRE MISSION -->
    <section class="py-24 bg-[#111827]">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center fade-in-up">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-12">
            Notre mission
          </h2>
          
          <!-- Card premium -->
          <div class="relative group">
            <div class="absolute inset-0 bg-gradient-to-r from-purple-600/20 to-purple-900/20 rounded-2xl blur-xl group-hover:blur-2xl transition-all duration-300"></div>
            <div class="relative bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-12 rounded-2xl border border-purple-500/20">
              <p class="text-xl md:text-2xl text-gray-200 leading-relaxed">
                Concevoir des solutions digitales sur mesure qui renforcent votre présence en ligne, optimisent vos processus métier et accélèrent votre croissance.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3 - CE QUI NOUS DISTINGUE -->
    <section class="py-24 bg-[#0B0E14]">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold text-white text-center mb-16">
          Ce qui nous distingue
        </h2>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
          <!-- Card 1 -->
          <div class="group fade-in-up">
            <div class="relative h-full bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300">
              <!-- Glow violet au hover -->
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/10 group-hover:to-purple-900/10 rounded-2xl transition-all duration-300"></div>
              
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">
                  Expertise technique moderne
                </h3>
                <p class="text-gray-300">
                  Technologies à jour, solutions robustes et évolutives.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="group fade-in-up delay-100">
            <div class="relative h-full bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/10 group-hover:to-purple-900/10 rounded-2xl transition-all duration-300"></div>
              
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">
                  Relation client basée sur la confiance
                </h3>
                <p class="text-gray-300">
                  Écoute, transparence et accompagnement personnalisé.
                </p>
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="group fade-in-up delay-200">
            <div class="relative h-full bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/10 group-hover:to-purple-900/10 rounded-2xl transition-all duration-300"></div>
              
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-white mb-4">
                  Solutions pensées pour durer
                </h3>
                <p class="text-gray-300">
                  Performance, sécurité et retour sur investissement.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4 - NOTRE VISION -->
    <section class="py-24 bg-[#111827]">
      <div class="container mx-auto px-6">
        <div class="max-w-5xl mx-auto text-center fade-in-up">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-12">
            Notre vision
          </h2>
          <p class="text-2xl md:text-3xl text-gray-200 leading-relaxed">
            Devenir une référence en solutions digitales premium pour les entreprises souhaitant allier <span class="text-purple-400">technologie</span>, <span class="text-purple-400">efficacité</span> et <span class="text-purple-400">qualité</span>.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 5 - NOS VALEURS -->
    <section class="py-24 bg-[#0B0E14]">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold text-white text-center mb-16">
          Nos valeurs
        </h2>

        <div class="max-w-3xl mx-auto space-y-6">
          <!-- Valeur 1 -->
          <div class="flex items-center gap-6 p-6 bg-gradient-to-r from-[#1a1a2e] to-transparent rounded-xl border border-purple-500/20 fade-in-left">
            <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">Excellence technique</h3>
              <p class="text-gray-400">Code de qualité, solutions optimisées</p>
            </div>
          </div>

          <!-- Valeur 2 -->
          <div class="flex items-center gap-6 p-6 bg-gradient-to-r from-[#1a1a2e] to-transparent rounded-xl border border-purple-500/20 fade-in-left delay-100">
            <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">Transparence</h3>
              <p class="text-gray-400">Communication claire et honnête</p>
            </div>
          </div>

          <!-- Valeur 3 -->
          <div class="flex items-center gap-6 p-6 bg-gradient-to-r from-[#1a1a2e] to-transparent rounded-xl border border-purple-500/20 fade-in-left delay-200">
            <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">Innovation utile</h3>
              <p class="text-gray-400">Technologie au service de vos objectifs</p>
            </div>
          </div>

          <!-- Valeur 4 -->
          <div class="flex items-center gap-6 p-6 bg-gradient-to-r from-[#1a1a2e] to-transparent rounded-xl border border-purple-500/20 fade-in-left delay-300">
            <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-1">Partenariat long terme</h3>
              <p class="text-gray-400">Relations durables et croissance commune</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 6 - NOS ENGAGEMENTS -->
    <section class="py-24 bg-[#111827]">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold text-white text-center mb-16">
          Nos engagements
        </h2>

        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <!-- Engagement 1 -->
          <div class="p-8 bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-2xl border border-purple-500/20 fade-in-up">
            <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3">Solutions adaptées aux besoins réels</h3>
            <p class="text-gray-300">Analyse approfondie de vos enjeux pour des solutions sur mesure.</p>
          </div>

          <!-- Engagement 2 -->
          <div class="p-8 bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-2xl border border-purple-500/20 fade-in-up delay-100">
            <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3">Collaboration fluide</h3>
            <p class="text-gray-300">Communication régulière et méthodologie agile.</p>
          </div>

          <!-- Engagement 3 -->
          <div class="p-8 bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-2xl border border-purple-500/20 fade-in-up delay-200">
            <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3">Performance mesurable</h3>
            <p class="text-gray-300">Objectifs clairs et résultats quantifiables.</p>
          </div>

          <!-- Engagement 4 -->
          <div class="p-8 bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-2xl border border-purple-500/20 fade-in-up delay-300">
            <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3">Support et suivi</h3>
            <p class="text-gray-300">Accompagnement post-livraison et maintenance continue.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 7 - CTA FINAL -->
    <section class="py-24 bg-[#2A234A] relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-600/10 to-transparent"></div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center fade-in-up">
          <h2 class="text-4xl md:text-5xl font-bold text-white mb-8">
            Vous cherchez un partenaire digital fiable et engagé ?
          </h2>
          <p class="text-xl text-gray-300 mb-12">
            Discutons de votre projet et explorons ensemble les meilleures solutions pour votre entreprise.
          </p>
          <a 
            href="/contact" 
            class="inline-block px-10 py-5 bg-gradient-to-r from-purple-600 to-purple-700 text-white font-semibold rounded-xl hover:from-purple-700 hover:to-purple-800 transform hover:scale-105 transition-all duration-300 shadow-lg shadow-purple-500/30"
          >
            Parlons de votre projet
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .bg-noise {
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' /%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' /%3E%3C/svg%3E");
    }

    .animate-pulse-slow {
      animation: pulse-slow 8s ease-in-out infinite;
    }

    @keyframes pulse-slow {
      0%, 100% {
        opacity: 0.5;
      }
      50% {
        opacity: 0.8;
      }
    }

    .bg-gradient-radial {
      background: radial-gradient(circle at 50% 50%, var(--tw-gradient-stops));
    }

    .fade-in-up {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }

    .fade-in-left {
      animation: fadeInLeft 0.8s ease-out forwards;
      opacity: 0;
    }

    .fade-in-right {
      animation: fadeInRight 0.8s ease-out forwards;
      opacity: 0;
    }

    .delay-100 {
      animation-delay: 0.1s;
    }

    .delay-200 {
      animation-delay: 0.2s;
    }

    .delay-300 {
      animation-delay: 0.3s;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInLeft {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeInRight {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
  </style>

  <script is:inline src="/js/about-animations.js"></script>
</Layout>

