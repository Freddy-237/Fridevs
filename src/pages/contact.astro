---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Contact - FRIDEVS | Parlons de Votre Projet";
const pageDescription = "Contactez FRIDEVS pour votre projet digital. Réponse rapide, échange confidentiel, conseils personnalisés. Démarrez votre collaboration dès maintenant.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    <!-- HERO - CONTACT -->
    <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-gradient-to-b from-[#3B2667] via-[#553C9A] to-[#7C3AED] pt-28 pb-16 md:pt-32 md:pb-20">
      
      <!-- Animation de fond -->
      <div class="absolute inset-0 opacity-10">
        <div style="background-image: linear-gradient(rgba(139, 92, 246, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.1) 1px, transparent 1px); background-size: 50px 50px; width: 100%; height: 100%;"></div>
      </div>

      <div class="relative max-w-6xl mx-auto px-6 text-center">
        
        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-purple-400 transition-colors">Accueil</a>
          <span class="mx-2">/</span>
          <span class="text-purple-400">Contact</span>
        </nav>

        <!-- Titre -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight fade-in-up" style="font-family: 'DM Sans', sans-serif;">
          Parlons de votre 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
            projet
          </span>
        </h1>

        <!-- Sous-titre -->
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto fade-in-up delay-100">
          Décrivez-nous vos besoins, nous vous répondrons rapidement
        </p>
      </div>
    </section>

    <!-- SECTION 1 - FORMULAIRE DE CONTACT PRINCIPAL -->
    <section class="py-24 bg-[#0B0E14]">
      <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
          
          <!-- Colonne gauche - Texte de confiance -->
          <div class="space-y-8 fade-in-left">
            <h2 class="text-4xl md:text-5xl font-bold text-white">
              Démarrons une collaboration efficace
            </h2>
            
            <p class="text-lg text-gray-300 leading-relaxed">
              Chez <span class="text-purple-400 font-semibold">FRIDEVS</span>, chaque projet commence par une bonne compréhension de vos objectifs. Ce premier échange nous permet d'analyser vos besoins et de vous proposer une solution adaptée.
            </p>

            <!-- Points clés -->
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-white mb-1">Réponse rapide</h3>
                  <p class="text-gray-400">Nous vous revenons sous 24-48h maximum</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-white mb-1">Échange confidentiel</h3>
                  <p class="text-gray-400">Vos informations sont protégées</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-purple-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-white mb-1">Conseils personnalisés</h3>
                  <p class="text-gray-400">Nous analysons vos besoins spécifiques</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Colonne droite - Formulaire premium -->
          <div class="fade-in-right">
            <form id="contact-form" class="bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-purple-500/20 space-y-6">
              
              <!-- Nom complet -->
              <div class="relative">
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  class="w-full bg-[#0B0E14] border border-gray-700 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all outline-none peer"
                  placeholder=" "
                />
                <label 
                  for="name" 
                  class="absolute left-3 top-[-10px] text-sm text-purple-400 bg-[#1a1a2e] px-2 transition-all duration-200"
                >
                  Nom complet *
                </label>
              </div>

              <!-- Email -->
              <div class="relative">
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  class="w-full bg-[#0B0E14] border border-gray-700 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all outline-none peer"
                  placeholder=" "
                />
                <label 
                  for="email" 
                  class="absolute left-3 top-[-10px] text-sm text-purple-400 bg-[#1a1a2e] px-2 transition-all duration-200"
                >
                  Email professionnel *
                </label>
              </div>

              <!-- Téléphone -->
              <div class="relative">
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="w-full bg-[#0B0E14] border border-gray-700 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all outline-none peer"
                  placeholder=" "
                />
                <label 
                  for="phone" 
                  class="absolute left-3 top-[-10px] text-sm text-gray-400 bg-[#1a1a2e] px-2 transition-all duration-200"
                >
                  Téléphone (optionnel)
                </label>
              </div>

              <!-- Type de projet -->
              <div class="relative">
                <select 
                  id="project-type" 
                  name="project-type" 
                  required 
                  class="w-full bg-[#0B0E14] border border-gray-700 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all outline-none"
                >
                  <option value="">Sélectionnez un type de projet</option>
                  <option value="site-vitrine">Site vitrine</option>
                  <option value="app-web">Application web</option>
                  <option value="app-mobile">Application mobile</option>
                  <option value="refonte">Refonte</option>
                  <option value="autre">Autre</option>
                </select>
                <label 
                  for="project-type" 
                  class="absolute left-3 top-[-10px] text-sm text-purple-400 bg-[#1a1a2e] px-2"
                >
                  Type de projet *
                </label>
              </div>

              <!-- Budget -->
              <div class="relative">
                <input 
                  type="text" 
                  id="budget" 
                  name="budget" 
                  class="w-full bg-[#0B0E14] border border-gray-700 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all outline-none peer"
                  placeholder=" "
                />
                <label 
                  for="budget" 
                  class="absolute left-3 top-[-10px] text-sm text-gray-400 bg-[#1a1a2e] px-2 transition-all duration-200"
                >
                  Budget estimatif (optionnel)
                </label>
              </div>

              <!-- Message -->
              <div class="relative">
                <textarea 
                  id="message" 
                  name="message" 
                  rows="5" 
                  required 
                  class="w-full bg-[#0B0E14] border border-gray-700 rounded-lg px-4 py-3 text-white focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all outline-none resize-none peer"
                  placeholder=" "
                ></textarea>
                <label 
                  for="message" 
                  class="absolute left-3 top-[-10px] text-sm text-purple-400 bg-[#1a1a2e] px-2 transition-all duration-200"
                >
                  Message *
                </label>
              </div>

              <!-- Bouton submit -->
              <button 
                type="submit" 
                class="w-full px-8 py-4 bg-gradient-to-r from-purple-600 to-purple-700 text-white font-semibold rounded-xl hover:from-purple-700 hover:to-purple-800 transform hover:scale-[1.02] transition-all duration-300 shadow-lg shadow-purple-500/30 flex items-center justify-center gap-2"
              >
                Envoyer la demande
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>

              <!-- Message de succès/erreur -->
              <div id="form-message" class="hidden text-center p-4 rounded-lg"></div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2 - AUTRES MOYENS DE CONTACT -->
    <section class="py-24 bg-[#111827]">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold text-white text-center mb-16 fade-in-up">
          Autres moyens de nous contacter
        </h2>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
          
          <!-- Email -->
          <div class="group fade-in-up">
            <div class="relative h-full bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 text-center hover:transform hover:scale-105">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/10 group-hover:to-purple-900/10 rounded-2xl transition-all duration-300"></div>
              
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6 mx-auto">
                  <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Email</h3>
                <a href="mailto:contact@fridevs.com" class="text-purple-400 hover:text-purple-300 transition-colors">
                  contact@fridevs.com
                </a>
              </div>
            </div>
          </div>

          <!-- Téléphone / WhatsApp -->
          <div class="group fade-in-up delay-100">
            <div class="relative h-full bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 text-center hover:transform hover:scale-105">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/10 group-hover:to-purple-900/10 rounded-2xl transition-all duration-300"></div>
              
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6 mx-auto">
                  <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Téléphone / WhatsApp</h3>
                <a href="https://wa.me/237694634551" target="_blank" class="text-purple-400 hover:text-purple-300 transition-colors">
                  +237 694 634 551
                </a>
              </div>
            </div>
          </div>

          <!-- Localisation -->
          <div class="group fade-in-up delay-200">
            <div class="relative h-full bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] p-8 rounded-2xl border border-gray-800 hover:border-purple-500/50 transition-all duration-300 text-center hover:transform hover:scale-105">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600/0 to-purple-900/0 group-hover:from-purple-600/10 group-hover:to-purple-900/10 rounded-2xl transition-all duration-300"></div>
              
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-600/20 rounded-xl flex items-center justify-center mb-6 mx-auto">
                  <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-3">Localisation</h3>
                <p class="text-gray-400">
                  Travail à distance<br />
                  Clients internationaux
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3 - RÉASSURANCE -->
    <section class="py-20 bg-[#0B0E14]">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-3 gap-8 text-center">
            
            <div class="fade-in-up">
              <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-4 mx-auto">
                <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Données confidentielles</h3>
              <p class="text-gray-400 text-sm">Vos informations sont protégées et traitées avec soin</p>
            </div>

            <div class="fade-in-up delay-100">
              <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-4 mx-auto">
                <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Aucun spam</h3>
              <p class="text-gray-400 text-sm">Nous respectons votre boîte de réception</p>
            </div>

            <div class="fade-in-up delay-200">
              <div class="w-14 h-14 bg-purple-600/20 rounded-xl flex items-center justify-center mb-4 mx-auto">
                <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">Réponse sous 24-48h</h3>
              <p class="text-gray-400 text-sm">Nous revenons vers vous rapidement</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4 - FAQ COURTE -->
    <section class="py-24 bg-[#111827]">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl md:text-5xl font-bold text-white text-center mb-16 fade-in-up">
          Questions fréquentes
        </h2>

        <div class="max-w-3xl mx-auto space-y-4">
          
          <!-- FAQ 1 -->
          <div class="faq-item bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-xl border border-gray-800 overflow-hidden fade-in-up">
            <button class="faq-question w-full text-left p-6 flex items-center justify-between text-white hover:text-purple-400 transition-colors">
              <span class="font-semibold text-lg">Quel est le délai de réponse ?</span>
              <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-answer hidden p-6 pt-0 text-gray-300">
              Nous nous engageons à répondre à toutes les demandes sous 24 à 48 heures maximum. Les demandes urgentes peuvent être traitées plus rapidement via WhatsApp.
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="faq-item bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-xl border border-gray-800 overflow-hidden fade-in-up delay-100">
            <button class="faq-question w-full text-left p-6 flex items-center justify-between text-white hover:text-purple-400 transition-colors">
              <span class="font-semibold text-lg">Travaillez-vous avec des clients à distance ?</span>
              <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-answer hidden p-6 pt-0 text-gray-300">
              Oui, nous travaillons avec des clients partout dans le monde. Nos processus sont entièrement adaptés au travail à distance avec des outils de communication modernes et efficaces.
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="faq-item bg-gradient-to-br from-[#1a1a2e] to-[#0B0E14] rounded-xl border border-gray-800 overflow-hidden fade-in-up delay-200">
            <button class="faq-question w-full text-left p-6 flex items-center justify-between text-white hover:text-purple-400 transition-colors">
              <span class="font-semibold text-lg">Proposez-vous un accompagnement après livraison ?</span>
              <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="faq-answer hidden p-6 pt-0 text-gray-300">
              Absolument. Nous proposons des contrats de maintenance et de support adaptés à vos besoins. Chaque projet inclut également une période de garantie et un accompagnement pour la prise en main.
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .fade-in-up {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }

    .fade-in-left {
      animation: fadeInLeft 0.8s ease-out forwards;
      opacity: 0;
    }

    .fade-in-right {
      animation: fadeInRight 0.8s ease-out forwards;
      opacity: 0;
    }

    .delay-100 {
      animation-delay: 0.1s;
    }

    .delay-200 {
      animation-delay: 0.2s;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeInLeft {
      from {
        opacity: 0;
        transform: translateX(-30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes fadeInRight {
      from {
        opacity: 0;
        transform: translateX(30px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
  </style>

  <script is:inline src="/js/contact.js"></script>
</Layout>