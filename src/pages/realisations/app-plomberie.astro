---
/**
 * ÉTUDE DE CAS - APPLICATION MOBILE DE PLOMBERIE
 * 
 * Plateforme de gestion d'interventions avec géolocalisation
 */

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const pageTitle = "Étude de Cas : Application Mobile Plomberie | FRIDEVS";
const pageDescription = "Application mobile complète pour la gestion d'interventions de plomberie avec géolocalisation et réservation en temps réel.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    
    <!-- 1. HERO PROJET -->
    <section class="relative min-h-[70vh] flex items-center overflow-hidden bg-gradient-to-br from-[#0B0E14] via-[#1a062e] to-[#2A234A] pt-28 pb-16">
      
      <div class="absolute inset-0 opacity-10">
        <div style="background-image: linear-gradient(rgba(139, 92, 246, 0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.15) 1px, transparent 1px); background-size: 60px 60px; width: 100%; height: 100%;"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-6">
        
        <nav class="text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-purple-400 transition-colors">Accueil</a>
          <span class="mx-2">/</span>
          <a href="/realisations" class="hover:text-purple-400 transition-colors">Réalisations</a>
          <span class="mx-2">/</span>
          <span class="text-purple-400">Application Plomberie</span>
        </nav>

        <div class="grid md:grid-cols-2 gap-12 items-center">
          
          <div class="space-y-6">
            
            <div class="flex gap-3">
              <span class="px-4 py-2 bg-purple-600/20 text-purple-400 text-sm font-semibold rounded-lg border border-purple-500/30">
                Mobile / Service
              </span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight" style="font-family: 'DM Sans', sans-serif;">
              Application Mobile Plomberie
            </h1>

            <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">
              Plateforme mobile complète pour connecter clients et plombiers avec géolocalisation et réservation en temps réel
            </p>

            <div class="grid grid-cols-2 gap-6 pt-4">
              <div>
                <p class="text-gray-500 text-sm mb-1">Secteur</p>
                <p class="text-white font-semibold text-lg">Services à domicile</p>
              </div>
              <div>
                <p class="text-gray-500 text-sm mb-1">Durée</p>
                <p class="text-white font-semibold text-lg">4 mois</p>
              </div>
              <div>
                <p class="text-gray-500 text-sm mb-1">Technologies</p>
                <p class="text-white font-semibold text-lg">React Native, Node.js, MongoDB</p>
              </div>
              <div>
                <p class="text-gray-500 text-sm mb-1">Plateformes</p>
                <p class="text-white font-semibold text-lg">iOS & Android</p>
              </div>
            </div>

          </div>

          <div class="relative">
            <div class="aspect-square bg-gradient-to-br from-purple-900/30 to-purple-600/20 rounded-2xl border border-purple-500/30 flex items-center justify-center backdrop-blur-sm">
              <svg class="w-40 h-40 text-purple-400/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
          </div>

        </div>

      </div>

    </section>

    <!-- 2. CONTEXTE -->
    <section class="py-20 bg-[#111827]">
      <div class="max-w-5xl mx-auto px-6">
        
        <div class="space-y-8">
          
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'DM Sans', sans-serif;">
              Contexte & Objectif
            </h2>
            <div class="w-20 h-1 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full"></div>
          </div>

          <div class="bg-[#0B0E14] rounded-2xl p-8 border border-gray-800">
            <h3 class="text-xl font-bold text-purple-400 mb-4" style="font-family: 'Space Grotesk', sans-serif;">
              Le client
            </h3>
            <p class="text-gray-300 text-lg leading-relaxed">
              Réseau de plombiers indépendants cherchant à moderniser leur système de prise de rendez-vous et améliorer leur visibilité auprès des clients locaux.
            </p>
          </div>

          <div class="bg-[#0B0E14] rounded-2xl p-8 border border-gray-800">
            <h3 class="text-xl font-bold text-purple-400 mb-4" style="font-family: 'Space Grotesk', sans-serif;">
              Le problème initial
            </h3>
            <ul class="space-y-3 text-gray-300 text-lg">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-red-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Réservations uniquement par téléphone, disponibilité limitée</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-red-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Difficulté pour les clients de trouver un plombier disponible rapidement</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-red-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Pas de traçabilité des interventions et des paiements</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-red-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span>Manque de visibilité en ligne face à la concurrence</span>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </section>

    <!-- 3. SOLUTION -->
    <section class="py-20 bg-[#0B0E14]">
      <div class="max-w-5xl mx-auto px-6">
        
        <div class="space-y-8">
          
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'DM Sans', sans-serif;">
              La solution FRIDEVS
            </h2>
            <div class="w-20 h-1 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full"></div>
          </div>

          <p class="text-xl text-gray-300 leading-relaxed">
            Nous avons développé une application mobile double-face (client & plombier) avec géolocalisation, réservation instantanée et système de paiement intégré.
          </p>

          <div class="grid md:grid-cols-2 gap-6">
            
            <div class="bg-[#111827] rounded-xl p-6 border border-gray-800">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-purple-600/10 rounded-lg">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Géolocalisation en temps réel</h4>
                  <p class="text-gray-400">Recherche des plombiers disponibles à proximité avec temps d'arrivée estimé</p>
                </div>
              </div>
            </div>

            <div class="bg-[#111827] rounded-xl p-6 border border-gray-800">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-purple-600/10 rounded-lg">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Réservation instantanée</h4>
                  <p class="text-gray-400">Prise de RDV en 3 clics avec confirmation immédiate</p>
                </div>
              </div>
            </div>

            <div class="bg-[#111827] rounded-xl p-6 border border-gray-800">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-purple-600/10 rounded-lg">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Paiement sécurisé</h4>
                  <p class="text-gray-400">Intégration Mobile Money et carte bancaire</p>
                </div>
              </div>
            </div>

            <div class="bg-[#111827] rounded-xl p-6 border border-gray-800">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-purple-600/10 rounded-lg">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Système d'avis</h4>
                  <p class="text-gray-400">Notation et commentaires pour garantir la qualité</p>
                </div>
              </div>
            </div>

            <div class="bg-[#111827] rounded-xl p-6 border border-gray-800">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-purple-600/10 rounded-lg">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Notifications push</h4>
                  <p class="text-gray-400">Alertes en temps réel pour chaque étape de l'intervention</p>
                </div>
              </div>
            </div>

            <div class="bg-[#111827] rounded-xl p-6 border border-gray-800">
              <div class="flex items-start gap-4">
                <div class="p-3 bg-purple-600/10 rounded-lg">
                  <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-lg font-bold text-white mb-2">Historique complet</h4>
                  <p class="text-gray-400">Toutes les interventions et factures accessibles</p>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- 4. TECHNOLOGIES -->
    <section class="py-20 bg-[#111827]">
      <div class="max-w-5xl mx-auto px-6">
        
        <div class="space-y-8">
          
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'DM Sans', sans-serif;">
              Stack technique
            </h2>
            <div class="w-20 h-1 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full"></div>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            
            <div class="bg-[#0B0E14] rounded-xl p-6 border border-gray-800">
              <h4 class="text-lg font-bold text-purple-400 mb-4">Mobile</h4>
              <ul class="space-y-2 text-gray-300">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  React Native
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  TypeScript
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  React Navigation
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Google Maps API
                </li>
              </ul>
            </div>

            <div class="bg-[#0B0E14] rounded-xl p-6 border border-gray-800">
              <h4 class="text-lg font-bold text-purple-400 mb-4">Backend</h4>
              <ul class="space-y-2 text-gray-300">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Node.js
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Express.js
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  MongoDB
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Socket.io
                </li>
              </ul>
            </div>

            <div class="bg-[#0B0E14] rounded-xl p-6 border border-gray-800">
              <h4 class="text-lg font-bold text-purple-400 mb-4">Services</h4>
              <ul class="space-y-2 text-gray-300">
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Firebase (Push)
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Stripe Payment
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  AWS S3
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 bg-purple-500 rounded-full"></span>
                  Twilio SMS
                </li>
              </ul>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- 5. RÉSULTATS -->
    <section class="py-20 bg-[#0B0E14]">
      <div class="max-w-5xl mx-auto px-6">
        
        <div class="space-y-8">
          
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'DM Sans', sans-serif;">
              Résultats obtenus
            </h2>
            <div class="w-20 h-1 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full"></div>
          </div>

          <div class="grid md:grid-cols-3 gap-6">
            
            <div class="bg-gradient-to-br from-purple-900/20 to-purple-600/10 rounded-2xl p-8 border border-purple-500/30 text-center">
              <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600 mb-3">
                500+
              </div>
              <p class="text-xl text-gray-300 font-semibold mb-2">Téléchargements</p>
              <p class="text-gray-400 text-sm">En 2 mois de lancement</p>
            </div>

            <div class="bg-gradient-to-br from-purple-900/20 to-purple-600/10 rounded-2xl p-8 border border-purple-500/30 text-center">
              <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600 mb-3">
                4.3/5
              </div>
              <p class="text-xl text-gray-300 font-semibold mb-2">Note moyenne</p>
              <p class="text-gray-400 text-sm">Sur les app stores</p>
            </div>

            <div class="bg-gradient-to-br from-purple-900/20 to-purple-600/10 rounded-2xl p-8 border border-purple-500/30 text-center">
              <div class="text-5xl md:text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600 mb-3">
                15min
              </div>
              <p class="text-xl text-gray-300 font-semibold mb-2">Temps de réponse</p>
              <p class="text-gray-400 text-sm">Moyen d'intervention</p>
            </div>

          </div>

          <div class="bg-[#111827] rounded-2xl p-8 border border-gray-800">
            <h3 class="text-xl font-bold text-purple-400 mb-6" style="font-family: 'Space Grotesk', sans-serif;">
              Bénéfices concrets
            </h3>
            <ul class="space-y-4 text-gray-300 text-lg">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Augmentation de 60% des réservations pour les plombiers partenaires</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Réduction drastique des appels téléphoniques de prise de RDV</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Traçabilité complète de toutes les interventions et paiements</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Satisfaction client accrue grâce au système d'avis transparent</span>
              </li>
            </ul>
          </div>

        </div>

      </div>
    </section>

    <!-- 6. TÉMOIGNAGE -->
    <section class="py-20 bg-gradient-to-br from-[#2A234A] to-[#1a062e]">
      <div class="max-w-4xl mx-auto px-6">
        
        <div class="text-center space-y-8">
          
          <svg class="w-16 h-16 text-purple-400/40 mx-auto" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>

          <blockquote class="text-2xl md:text-3xl text-white leading-relaxed italic font-light">
            « Grâce à cette application, j'ai doublé mon nombre de clients en quelques mois. Les réservations arrivent directement et je peux organiser mes journées efficacement. »
          </blockquote>

          <div class="pt-6">
            <p class="text-xl font-bold text-purple-300">Paul K.</p>
            <p class="text-gray-400">Plombier partenaire depuis 6 mois</p>
          </div>

        </div>

      </div>
    </section>

    <!-- 7. CTA -->
    <section class="py-20 bg-[#111827]">
      <div class="max-w-4xl mx-auto px-6 text-center">
        
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6" style="font-family: 'DM Sans', sans-serif;">
          Vous avez un projet similaire ?
        </h2>

        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
          Nous développons des applications mobiles performantes sur iOS et Android. Discutons de votre projet.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          
          <a 
            href="https://wa.me/237694634551?text=Bonjour%2C%20j'ai%20vu%20le%20projet%20Application%20Plomberie%20et%20je%20souhaite%20discuter%20d'un%20projet%20similaire" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white text-lg font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-purple-500/50 hover:scale-105"
            style="font-family: 'Space Grotesk', sans-serif;"
          >
