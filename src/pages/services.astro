                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <p class="text-sm text-gray-400">Next.js</p>
                </div>
                <div class="text-center">
                  <div class="w-16 h-16 mx-auto mb-2 bg-purple-500/10 rounded-lg flex items-center justify-center">
