            </div>

            <!-- Technologies -->
            <div class="bg-[#111827] p-8 rounded-2xl border border-gray-800">
              <h3 class="text-lg font-semibold text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif;">
                Technologies utilisées
              </h3>
              
              <div class="grid grid-cols-3 gap-6">
                <div class="text-center">
                  <div class="w-16 h-16 mx-auto mb-2 bg-purple-500/10 rounded-lg flex items-center justify-center">
                    <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
