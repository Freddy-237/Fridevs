---
/**
 * PAGE SERVICES
 * 
 * Présentation des 4 services principaux de FRIDEVS
 */

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Nos Services - Développement Web, Mobile, SEO & UI/UX | FRIDEVS";
const pageDescription = "Découvrez nos services premium : développement web & mobile sur mesure, solutions métiers innovantes, optimisation SEO et design UI/UX. Expertise complète pour votre transformation digitale.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    
    <!-- HERO SERVICES -->
    <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-gradient-to-b from-[#3B2667] via-[#553C9A] to-[#7C3AED] pt-28 pb-16 md:pt-32 md:pb-20">
      
      <div class="absolute inset-0 opacity-10">
        <div style="background-image: linear-gradient(rgba(139, 92, 246, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.1) 1px, transparent 1px); background-size: 50px 50px; width: 100%; height: 100%;"></div>
      </div>

      <div class="relative max-w-6xl mx-auto px-6 text-center">
        
        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-400 mb-6">
          <a href="/" class="hover:text-purple-400 transition-colors">Accueil</a>
          <span class="mx-2">/</span>
          <span class="text-white">Services</span>
        </nav>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" style="font-family: 'DM Sans', sans-serif;">
          Des solutions digitales 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
            pensées pour votre croissance
          </span>
        </h1>

        <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
          Nous transformons vos ambitions en outils digitaux performants, sécurisés et évolutifs.
        </p>

        <a 
          href="https://wa.me/237694634551" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-4 bg-purple-600 hover:bg-purple-700 text-white text-lg font-semibold rounded-lg transition-all duration-300 shadow-lg hover:shadow-purple-500/50 hover:scale-105"
          style="font-family: 'Space Grotesk', sans-serif;"
        >
          Discutons de votre projet
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

      </div>

    </section>

    <!-- SERVICES GRID -->
    <section class="py-20 bg-[#0B0E14]">
      <div class="max-w-7xl mx-auto px-6">

        <!-- SERVICE 1 : Développement Web & Mobile -->
        <div class="mb-20 pb-20 border-b border-gray-800">
          
          <div class="grid md:grid-cols-2 gap-12 items-start">
            
            <!-- Texte -->
            <div>
              <div class="inline-block px-4 py-2 bg-purple-500/10 border border-purple-500/30 rounded-full text-purple-400 text-sm font-semibold mb-4">
                Service 01
              </div>
              
              <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'DM Sans', sans-serif;">
                Développement Web & Mobile
              </h2>
              
              <p class="text-xl text-purple-300 mb-6">
                Des plateformes web et applications conçues pour durer
              </p>

              <p class="text-gray-400 leading-relaxed mb-6">
                Nous créons des sites vitrines premium, des applications web performantes et des backends sécurisés. Chaque solution est pensée pour offrir une expérience utilisateur exceptionnelle et une évolutivité maximale.
