                  <div class="text-center space-y-3 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                    <span class="text-white font-bold text-xl block">Voir l'étude de cas</span>
                    <svg class="w-8 h-8 text-white mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Contenu -->
              <div class="p-6 space-y-4">
                
                <!-- Tags -->
                <div class="flex flex-wrap gap-2">
                  <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">CRM</span>
                  <span class="px-3 py-1 bg-purple-600/10 text-purple-400 text-xs font-medium rounded-full">Solution métier</span>
                </div>

                <!-- Nom projet -->
                <h3 class="text-2xl font-bold text-white group-hover:text-purple-400 transition-colors" style="font-family: 'Space Grotesk Variable', sans-serif;">
                  INUBIL
                </h3>

                <!-- Description courte -->
                <p class="text-gray-400 leading-relaxed">
                  Solution CRM sur mesure pour optimiser la gestion commerciale et automatiser les processus.
                </p>

                <!-- Type -->
                <div class="flex items-center gap-2 text-sm text-purple-400 pt-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                  <span>Outil métier / Web</span>
                </div>

              </div>
            </div>
          </a>

          <!-- Projet 3: App Plomberie -->
