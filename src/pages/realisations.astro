---
/**
 * PAGE RÉALISATIONS
 * 
 * Études de cas détaillées des projets FRIDEVS
 */

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "Nos Réalisations - Études de Cas | FRIDEVS";
const pageDescription = "Découvrez nos projets concrets : CRM sur mesure, applications mobiles, solutions métiers. Résultats mesurables et expertise prouvée.";
import Scene3D from "../components/Scene3D.astro";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main>
    
    <!-- HERO RÉALISATIONS -->
    <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-gradient-to-b from-[#3B2667] via-[#553C9A] to-[#7C3AED] pt-28 pb-16 md:pt-32 md:pb-20">
      
      <!-- Animation de fond -->
      <div class="absolute inset-0 opacity-10">
        <div style="background-image: linear-gradient(rgba(139, 92, 246, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(139, 92, 246, 0.1) 1px, transparent 1px); background-size: 50px 50px; width: 100%; height: 100%;"></div>
      </div>

      <div class="relative max-w-6xl mx-auto px-6 text-center">
        
        <!-- Breadcrumb -->
        <nav class="text-sm text-gray-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-purple-400 transition-colors">Accueil</a>
          <span class="mx-2">/</span>
          <span class="text-purple-400">Réalisations</span>
        </nav>

        <!-- Titre -->
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight" style="font-family: 'DM Sans Variable', sans-serif;">
          Des projets conçus pour créer de la 
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-purple-600">
            valeur
          </span>
        </h1>

        <!-- Sous-titre -->
        <p class="text-xl md:text-2xl text-gray-300 max-w-3xl mx-auto mb-12">
          Chaque réalisation répond à un besoin métier précis et mesurable
        </p>

        <!-- Filtres -->
        <div class="flex flex-wrap justify-center gap-3">
          <button class="filter-btn active px-6 py-2.5 bg-purple-600 text-white font-medium rounded-lg transition-all duration-300 hover:bg-purple-700" data-filter="all">
            Tous
          </button>
          <button class="filter-btn px-6 py-2.5 bg-[#1a1a2e] text-gray-300 font-medium rounded-lg transition-all duration-300 hover:bg-purple-600/20 hover:text-purple-400 border border-gray-800" data-filter="web">
            Web
          </button>
          <button class="filter-btn px-6 py-2.5 bg-[#1a1a2e] text-gray-300 font-medium rounded-lg transition-all duration-300 hover:bg-purple-600/20 hover:text-purple-400 border border-gray-800" data-filter="mobile">
            Mobile
          </button>
          <button class="filter-btn px-6 py-2.5 bg-[#1a1a2e] text-gray-300 font-medium rounded-lg transition-all duration-300 hover:bg-purple-600/20 hover:text-purple-400 border border-gray-800" data-filter="outils">
            Outils métiers
          </button>
        </div>

      </div>

    </section>

    <!-- GRILLE DES PROJETS -->
    <section class="py-20 bg-[#0B0E14]">
      
      <div class="max-w-7xl mx-auto px-6">
        
        <!-- Grille responsive -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
          
          <!-- Projet 1: INUBIL (CRM) -->
          <a href="/realisations/inubil" class="project-item group block" data-category="web outils">
            <div class="bg-[#111827] rounded-2xl overflow-hidden border border-gray-800 hover:border-purple-500/50 transition-all duration-500 h-full">
              
              <!-- Image projet -->
              <div class="relative h-80 overflow-hidden bg-[#1a1a2e]">
                
                <!-- TODO: Remplacer par une vraie image du projet -->
                <!-- <img src="/images/projects/inubil.jpg" alt="Aperçu du projet INUBIL" class="w-full h-full object-cover" /> -->
                
                <!-- Placeholder temporaire -->
                <div class="scene3d-fallback absolute inset-0 flex items-center justify-center bg-gradient-to-br from-purple-900/20 to-purple-800/20">
                  <svg class="w-32 h-32 text-purple-500/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                </div>

                <Scene3D scene="dashboard" label="INUBIL" accent="#8b5cf6" />

                <!-- Overlay violet -->
