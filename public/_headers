# Cache Headers pour FRIDEVS
# Configuration optimale pour Netlify/Vercel

# Images - Cache 1 an (immutable)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript - Cache 1 an (immutable)
/js/*
  Cache-Control: public, max-age=31536000, immutable

# CSS - Cache 1 an (immutable)
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Fonts - Cache 1 an (immutable)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML - Cache court avec revalidation
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Page d'accueil - Cache court avec revalidation
/
  Cache-Control: public, max-age=0, must-revalidate

# Assets généraux - Cache 1 an
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
